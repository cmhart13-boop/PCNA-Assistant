# DO NOT put real credentials in GitHub.
# Copy these keys into the Streamlit Community Cloud app's Secrets settings.
PCNA_PROMOSTANDARDS_ID = "your-production-access-id"
PCNA_PROMOSTANDARDS_PASSWORD = "your-production-access-password"

# The app defaults to the staging endpoints documented by PCNA.
# If PCNA supplied different production endpoints, paste them here in Streamlit Secrets.
# PCNA_PRODUCT_SELLABLE_ENDPOINT = "https://..."
# PCNA_PRODUCT_DATA_ENDPOINT = "https://..."
# PCNA_PRICING_ENDPOINT = "https://..."
# PCNA_MEDIA_ENDPOINT = "https://..."
# PCNA_INVENTORY_ENDPOINT = "https://..."
